# Ignore all data files and directories
data/raw/
data/processed/
data/interim/
*.tsv
*.csv
!results/holdout/
!results/holdout/*.csv
!results/holdout/retrieval/
!results/holdout/retrieval/*.csv
!results/cross_axis_bridge/fine_tuned_cross_axis_spearman_table.csv
*.parquet
*.pkl
*.pickle
*.h5
*.hdf5
*.feather

# Ignore Python cache files
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Ignore virtual environment
.venv/
venv/
ENV/
env/

# Ignore Jupyter checkpoints
.ipynb_checkpoints/

# macOS files
.DS_Store

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Model files (if you save models later)
*.pt
*.pth
*.ckpt
*.model

# Embeddings and numpy arrays
*.npy
*.npz
data/embeddings/

# Results (keep folder structure but not large files)
results/*.png
results/*.pdf
results/*.npy

# Public result CSVs are tracked despite the blanket *.csv ignore above.
# Keep *.csv as default-deny (blocks accidental commit of identifying CSVs);
# whitelist only these known-clean, MassSpecGym-derived result files.
!results/shared/splits.csv
!results/holdout/holdout_metrics_maccs_bce.csv
!results/holdout/retrieval/holdout_per_spectrum_ranks.csv
!results/axis3/specific/axis3_specific_retrieval_metrics.csv
!results/axis3/specific/axis3_specific_per_bit_auroc.csv
!results/axis3/specific/axis3_specific_per_spectrum_ranks.csv
!results/cross_axis/fine_tuned_cross_axis_spearman_table.csv
